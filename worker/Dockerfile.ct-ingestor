FROM rust:1.88-bookworm AS build

WORKDIR /src
COPY Cargo.toml ./
RUN mkdir -p src/bin && echo 'fn main() {}' > src/main.rs && echo 'fn main() {}' > src/bin/ct_ingestor.rs && cargo build --release --bin atlas-ct-ingestor && rm -rf src

COPY src ./src
RUN touch src/bin/ct_ingestor.rs && cargo build --release --bin atlas-ct-ingestor

FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=build /src/target/release/atlas-ct-ingestor /app/atlas-ct-ingestor
CMD ["/app/atlas-ct-ingestor"]
